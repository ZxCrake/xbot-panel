# ── Copy to .env and fill in. NEVER commit the real .env. ──

# Environment: production | development
XBOT_ENV=production

# Secret key for signing auth tokens. REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# Database connection (SQLAlchemy URL).
# SQLite (default, simple):  sqlite:////app/data/xbot.db
# PostgreSQL (recommended):  postgresql+psycopg2://xbot:STRONG_PASS@db:5432/xbot
DATABASE_URL=postgresql+psycopg2://xbot:change-me@db:5432/xbot

# CORS: exact origin of the front-end. Leave empty for same-origin only.
# Example: https://panel.example.com
FRONTEND_ORIGIN=

# Auth token lifetime (seconds). Default 7 days.
TOKEN_MAX_AGE=604800

# Brute-force lockout: lock an account after N failed logins for M seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Rate-limit storage. memory:// for single process; redis://redis:6379 for prod.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# Behind a TLS-terminating reverse proxy (nginx)? Enables HSTS + secure trust.
BEHIND_PROXY=true

# X client signing key (bot engine). Override only if you know what you're doing.
XPFF_BASE_KEY=0e6be1f1e21ffc33590b888fd4dc81b19713e570e805d4e5df80a493c9571a05

# ── PostgreSQL container credentials (used by docker-compose) ──
POSTGRES_USER=xbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xbot
