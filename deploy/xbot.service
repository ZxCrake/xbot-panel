# systemd unit for a bare-metal (non-Docker) deployment.
# Install: copy to /etc/systemd/system/xbot.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now xbot
[Unit]
Description=X Automation Panel
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=xbot
Group=xbot
WorkingDirectory=/opt/xbot
EnvironmentFile=/opt/xbot/.env
ExecStartPre=/opt/xbot/.venv/bin/alembic upgrade head
ExecStart=/opt/xbot/.venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/xbot/data

[Install]
WantedBy=multi-user.target
